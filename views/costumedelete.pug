extends layout

block content
  .container.mt-4
    .card.shadow-sm
      .card-header.bg-primary.text-white
        h2.mb-0 Costume Detail
      .card-body
        if item
          table.table.table-bordered.mt-2
            tbody
              tr
                th.attr-label Costume Type
                td #{item.costume_type}
              tr
                th.attr-label Size
                td #{item.size}
              tr
                th.attr-label Cost
                td $#{item.cost}
          .mt-3
            a.btn.btn-secondary(href='/costumes') Back to List
        else
          p.text-danger No costume found with that ID.
          a.btn.btn-secondary(href='/costumes') Back to List