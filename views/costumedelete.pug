extends layout

block content
  h1 Delete Costume
  if item
    p.text-danger Are you sure you want to delete this costume?
    p
      span.attr-label Costume Type:
      | #{item.costume_type}
    p
      span.attr-label Size:
      | #{item.size}
    p
      span.attr-label Cost:
      | $#{item.cost}

    button#deleteBtn.btn.btn-danger Delete
    a.btn.btn-secondary.ms-2(href='/costumes') Cancel

    script.
      document.getElementById('deleteBtn').addEventListener('click', async function() {
        const response = await fetch('/resource/costumes/#{item._id}', {
          method: 'DELETE'
        });
        if (response.ok) {
          alert('Costume deleted successfully!');
          window.location.href = '/costumes';
        } else {
          alert('Error deleting costume.');
        }
      });
  else
    p.text-danger No costume found with that ID.
    a.btn.btn-secondary(href='/costumes') Back to List